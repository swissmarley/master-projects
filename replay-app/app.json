{
  "expo": {
    "name": "Replay",
    "slug": "replay",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "replay",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0F",
    "ios": {
      "bundleIdentifier": "com.swissmarley.replay",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.swissmarley.replay",
      "adaptiveIcon": {
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#0B0B0F"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "youtube.com",
              "pathPrefix": "/watch"
            },
            {
              "scheme": "https",
              "host": "www.youtube.com",
              "pathPrefix": "/watch"
            },
            {
              "scheme": "https",
              "host": "m.youtube.com",
              "pathPrefix": "/watch"
            },
            {
              "scheme": "https",
              "host": "music.youtube.com",
              "pathPrefix": "/watch"
            },
            {
              "scheme": "https",
              "host": "www.youtube.com",
              "pathPrefix": "/shorts"
            },
            {
              "scheme": "https",
              "host": "m.youtube.com",
              "pathPrefix": "/shorts"
            },
            {
              "scheme": "https",
              "host": "youtu.be"
            }
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
